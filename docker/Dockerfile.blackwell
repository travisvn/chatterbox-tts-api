# NVIDIA-optimized PyTorch for DGX Spark / GB10 (sm_121)
FROM nvcr.io/nvidia/pytorch:26.01-py3

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies; retain NVIDIA's supplied Python and PyTorch.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv, but do not create an isolated environment that hides
# NVIDIA's preinstalled PyTorch.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

# Keep app deps separate from NVIDIA's system python packages.
# NVIDIA image includes compiled CUDA extensions linked against bundled
# PyTorch bins. When different PyTorch versions clash it causes ABI
# errors, undefined symbols, etc. during import.
# DO NOT use --system-site-packages flag or replace NVIDIA system binaries
# unless you validate compatibility with GPU and driver.
RUN python3 -m venv /app/.venv

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"

# Restore pkg_resources for resemble-perth compatibility.
RUN uv pip install "setuptools<81"

# Application and API dependencies.
RUN uv pip install \
    fastapi \
    "uvicorn[standard]" \
    python-dotenv \
    python-multipart \
    requests \
    psutil \
    pydub \
    sse-starlette

# Chatterbox dependencies, excluding PyTorch.
# NumPy 1.26.4 supports Python 3.12 and avoids the NumPy 2.x transition.
RUN uv pip install \
    numpy==1.26.4 \
    librosa==0.11.0 \
    s3tokenizer \
    transformers==4.46.3 \
    diffusers==0.29.0 \
    resemble-perth==1.0.1 \
    conformer==0.3.2 \
    safetensors==0.5.3 \
    pykakasi==2.3.0

# Install Chatterbox without resolving its dependencies.
# Its upstream dependency declarations pin older PyTorch versions;
# have to preserve NVIDIA's optimized PyTorch installation.
RUN uv pip install --no-deps \
    git+https://github.com/travisvn/chatterbox-multilingual.git@exp

# Copy application code.
COPY app/ ./app/
COPY main.py ./

# Optional fallback voice sample.
COPY voice-sample.mp3 ./voice-sample.mp3

# Create runtime directories.
RUN mkdir -p /cache /voices /data/long_text_jobs

# API configuration.
ENV PORT=4123
ENV EXAGGERATION=0.5
ENV CFG_WEIGHT=0.5
ENV TEMPERATURE=0.8
ENV VOICE_SAMPLE_PATH=/app/voice-sample.mp3
ENV MAX_CHUNK_LENGTH=280
ENV MAX_TOTAL_LENGTH=3000
ENV DEVICE=cuda
ENV MODEL_CACHE_DIR=/cache
ENV VOICE_LIBRARY_DIR=/voices
ENV HOST=0.0.0.0

# Long-text processing.
ENV LONG_TEXT_DATA_DIR=/data/long_text_jobs
ENV LONG_TEXT_MAX_LENGTH=100000
ENV LONG_TEXT_CHUNK_SIZE=2500
ENV LONG_TEXT_SILENCE_PADDING_MS=200
ENV LONG_TEXT_JOB_RETENTION_DAYS=7
ENV LONG_TEXT_MAX_CONCURRENT_JOBS=3

# NVIDIA container configuration.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=30s --start-period=5m --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

CMD ["python3", "main.py"]
